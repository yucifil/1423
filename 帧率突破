local function CreateToggleButton(parent, text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -30, 0, 36)
    btn.Position = UDim2.new(0, 15, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(45, 52, 68)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 205, 220)
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
    local isOn = false
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        if isOn then
            btn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
            btn.Text = text .. " ✅"
        else
            btn.BackgroundColor3 = Color3.fromRGB(45, 52, 68)
            btn.Text = text
        end
        callback(isOn)
    end)
    return btn
end

