-- ============================================================
-- 模块 1: 解除帧率上限 (全fflag组合尝试)
-- ============================================================
-- ★ 关键突破点: 下面这几个 fflag 组合可以推高渲染帧率
--   其中 "TaskSchedulerTargetFps" 控制渲染,
--   "RenderSteppedTargetFps" 影响心跳调度,
--   配合 "SchedulerTargetFps" 一起改有效
local function ApplyFpsUnlock(fps)
    pcall(function() if setfpscap then setfpscap(fps) end end)

    pcall(function()
        if setfflag then
            setfflag("TaskSchedulerTargetFps", tostring(fps))
            setfflag("DFIntTaskSchedulerTargetFps", tostring(fps))
            setfflag("SchedulerTargetFps", tostring(fps))
            setfflag("RenderSteppedTargetFps", tostring(fps))
            setfflag("MaxFPS", tostring(fps))
            setfflag("DisableRenderFrameLimit", "true")
            setfflag("DisableFrameRateCap", "true")
            setfflag("DFIntRenderingFpsLimit", tostring(fps))
        end
    end)

    pcall(function()
        local US = UserSettings()
        if US and US.GameSettings then
            US.GameSettings.FrameRateCap = fps
        end
    end)

    -- 关闭垂直同步 (会锁到显示器刷新率, 必须关)
    pcall(function() settings().Rendering.VSync = false end)
end

-- 关闭VSync的额外尝试 (Xeno 部分版本暴露)
pcall(function()
    if setfflag then
        setfflag("UseVSync", "false")
        setfflag("FIntVSync", "0")
    end
end)

-- ============================================================
-- 模块 2: 降低延迟
-- ============================================================
local function SaveAndOptimize()
    OriginalSettings.GlobalShadows = Lighting.GlobalShadows
    OriginalSettings.FogEnd = Lighting.FogEnd
    OriginalSettings.FogStart = Lighting.FogStart
    OriginalSettings.Ambient = Lighting.Ambient
    OriginalSettings.OutdoorAmbient = Lighting.OutdoorAmbient
    OriginalSettings.Brightness = Lighting.Brightness
    OriginalSettings.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
    OriginalSettings.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    pcall(function() OriginalSettings.QualityLevel = settings().Rendering.QualityLevel end)
    pcall(function() OriginalSettings.MeshPartDetailLevel = settings().Rendering.MeshPartDetailLevel end)

    pcall(function() Lighting.GlobalShadows = false end)
    pcall(function() Lighting.Brightness = 0 end)
    pcall(function() Lighting.EnvironmentDiffuseScale = 0 end)
    pcall(function() Lighting.EnvironmentSpecularScale = 0 end)
    pcall(function() Lighting.Ambient = Color3.fromRGB(128,128,128) end)
    pcall(function() Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128) end)
    pcall(function()
        Lighting.FogStart = 0
        Lighting.FogEnd = 200
        Lighting.FogColor = Color3.fromRGB(120,120,120)
    end)
    pcall(function()
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then
                table.insert(OriginalSettings.Effects, {instance=obj, enabled=obj.Enabled})
                obj.Enabled = false
            end
        end
    end)
    pcall(function()
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") then
                OriginalSettings.Sky = obj
                obj.Parent = nil
            end
        end
    end)
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end
    end)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            OriginalSettings.WaterReflectance = terrain.WaterReflectance
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
        end
    end)
end

local function RestoreAll()
    pcall(function() Lighting.GlobalShadows = OriginalSettings.GlobalShadows end)
    pcall(function() Lighting.FogEnd = OriginalSettings.FogEnd end)
    pcall(function() Lighting.FogStart = OriginalSettings.FogStart end)
    pcall(function() Lighting.Ambient = OriginalSettings.Ambient end)
    pcall(function() Lighting.OutdoorAmbient = OriginalSettings.OutdoorAmbient end)
    pcall(function() Lighting.Brightness = OriginalSettings.Brightness end)
    pcall(function() Lighting.EnvironmentDiffuseScale = OriginalSettings.EnvironmentDiffuseScale end)
    pcall(function() Lighting.EnvironmentSpecularScale = OriginalSettings.EnvironmentSpecularScale end)
    for _, data in ipairs(OriginalSettings.Effects) do
        if data.instance then pcall(function() data.instance.Enabled = data.enabled end) end
    end
    OriginalSettings.Effects = {}
    if OriginalSettings.Sky then
        pcall(function() OriginalSettings.Sky.Parent = Lighting end)
    end
    pcall(function()
        if OriginalSettings.QualityLevel then
            settings().Rendering.QualityLevel = OriginalSettings.QualityLevel
        end
    end)
    pcall(function()
        if OriginalSettings.MeshPartDetailLevel then
            settings().Rendering.MeshPartDetailLevel = OriginalSettings.MeshPartDetailLevel
        end
    end)
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain and OriginalSettings.WaterReflectance then
            terrain.WaterReflectance = OriginalSettings.WaterReflectance
        end
    end)
end

