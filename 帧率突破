-- ============================================================
-- 统计循环
-- ============================================================
local frameCount = 0
local fpsLastTime = tick()
local realFps = 0
local ping = 0
local memory = 0

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - fpsLastTime >= 1 then
        realFps = frameCount / (now - fpsLastTime)
        frameCount = 0
        fpsLastTime = now
        -- 记录引擎真实上限
        if realFps > RealFpsCap then RealFpsCap = realFps end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if not ShowStatsEnabled then
            StatsText.Text = "统计已暂停"
            continue
        end
        pcall(function()
            local p = Stats.Network.ServerStatsItem["Data Ping"]
            if p then ping = p:GetValue() end
        end)
        pcall(function()
            local m = Stats:GetTotalMemoryUsageMb()
            if m then memory = m end
        end)

        local frameTime = realFps > 0 and (1000 / realFps) or 0
        local totalLatency = ping + frameTime
        -- ★ 显示FPS = 真实FPS × 倍率
        local displayFps = realFps * DisplayMultiplier

        StatsText.Text = string.format(
            "FPS:      %.1f%s\n真实FPS:  %.1f\n上限:      %d\nPing:     %.0f ms\n帧延迟:   %.1f ms\n总延迟:   %.0f ms\n内存:     %.0f MB",
            displayFps, (DisplayMultiplier > 1 and (" (×"..DisplayMultiplier..")") or ""),
            realFps, TargetFps, ping, frameTime, totalLatency, memory
        )
    end
end)

