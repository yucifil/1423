-- 解除帧率上限
-- ============================================================
CreateToggleButton(MainFrame, "🚀 解除帧率上限", 55, function(s)
    FpsUnlockEnabled = s
    if s then
        ApplyFpsUnlock(TargetFps)
        if FpsLoopThread then task.cancel(FpsLoopThread) end
        FpsLoopThread = task.spawn(function()
            while FpsUnlockEnabled do
                pcall(function() ApplyFpsUnlock(TargetFps) end)
                task.wait(1)
            end
        end)
    else
        if FpsLoopThread then task.cancel(FpsLoopThread); FpsLoopThread = nil end
        ApplyFpsUnlock(60)
    end
end)

